@using Ocuda.Ops.Controllers.ViewModels.Locations
@model UpdateMapImageViewModel

<div class="d-flex mb-2">
    <h1 class="flex-grow-1 text-start">
        Map Image
        <small class="text-muted">@Model.Location.Name</small>
    </h1>
    <div>
        <a class="btn btn-outline-success"
           asp-action="@nameof(LocationsController.Details)"
           asp-route-slug="@Model.Location.Stub">Back</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 offset-lg-3">
        <div class="alert alert-success" id="status-message">
            <p class="mb-0">
                Note: if your API key is restricted by IP address and you are accessing via a split
                tunnel VPN, your local IP address must be configured for the API key.
            </p>
            @if (!string.IsNullOrEmpty(Model.Location?.MapImagePath))
            {
                <p class="mb-0 mt-3">The initial image is the current map.</p>
            }
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 offset-lg-3 d-flex justify-content-center align-items-center border p-0 bg-light"
         id="image-preview-container"
         style="min-width: @(Model.Width)px; min-height: @(Model.Height)px;">
        @if (!string.IsNullOrEmpty(Model.Location?.MapImagePath))
        {
            <img class="img-fluid"
                 src="@Url.Action(nameof(LocationsController.MapImage), LocationsController.Name, new { slug = Model.Location.Stub })" />
        }
    </div>
</div>

<div class="row mt-4">
    <div class="col-lg-6 offset-lg-3">
        <div class="row mb-3">
            <label class="col-sm-4" for="zoom-level">
                Zoom Level
                <span class="fa-regular fa-circle-question"
                      title="Google Maps zoom levels range from 0 to 18. For most locations, a zoom level between 12 - 14 is most practical."
                      data-bs-toggle="tooltip"
                      data-placement="top">
                </span>
            </label>
            <div class="col-sm-8">
                <input class="form-control"
                       id="zoom-level"
                       name="zoom-level"
                       type="number"
                       value="13"
                       min="0"
                       max="18" />
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-4" for="scale">
                Scale
                <span class="fa-regular fa-circle-question"
                      title="Scale value can be 1 or 2. For high dpi displays, use scale 2 to prevent image from being distorted."
                      data-bs-toggle="tooltip"
                      data-placement="top">
                </span>
            </label>
            <div class="col-sm-8">
                <input class="form-control"
                       id="scale"
                       name="scale"
                       type="number"
                       value="2"
                       min="1"
                       max="2"
                       disabled="disabled" />
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-4" for="image-width">Image Width</label>
            <div class="col-sm-8">
                <input class="form-control"
                       id="image-width"
                       name="image-width"
                       type="number"
                       step="10"
                       value="@Model.Width"
                       disabled="disabled" />
            </div>
        </div>
        <div class="row mb-3">
            <label class="col-sm-4" for="image-height">Image Height</label>
            <div class="col-sm-8">
                <input class="form-control"
                       id="image-height"
                       name="image-height"
                       type="number"
                       step="10"
                       value="@Model.Height"
                       disabled="disabled" />
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 offset-lg-3 d-flex justify-content-end">
        <button button-spinner
                class="btn btn-outline-primary me-2"
                id="preview-image">
            Preview
        </button>
        <button button-spinner
                class="btn btn-outline-success"
                id="save-image" disabled>
            Optimize and Save
        </button>
    </div>

</div>

@section Scripts
{
    <script>
        $(function() {
            $('[data-bs-toggle="tooltip"]').tooltip()
        });

        document.querySelector('#preview-image').addEventListener('click', showPreview);
        document.querySelector('#save-image').addEventListener('click', saveImage);
        document.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                showPreview();
            }
        })

        const locationAddress = "@Model.Location.Address";
        const apiKey = "@Model.MapApiKey";
        const fileName = "@Model.Location.Stub";

        const optimizePath = "@Url.Action(nameof(Ocuda.Ops.Controllers.Areas.SiteManagement.ImageOptimizerController.OptimizeFromBase64), Ocuda.Ops.Controllers.Areas.SiteManagement.ImageOptimizerController.Name)";
        const savePath = "@Url.Action(nameof(LocationsController.UpdateMapImage), LocationsController.Name, new { slug = Model.Location.Stub })";

        const zoomEl = document.querySelector('#zoom-level');
        const scaleEl = document.querySelector('#scale');
        const widthEl = document.querySelector('#image-width');
        const heightEl = document.querySelector('#image-height');

        const statusContainer = document.querySelector('#status-message');
        const imgContainer = document.querySelector('#image-preview-container');

        let requestingPreview = false;
        let imageBase64;

        function inputsComplete() {
            let complete = true;
            document.querySelectorAll('input').forEach(input => {
                if (!input.value) {
                    input.parentElement.firstElementChild.classList.add("text-danger");
                    complete = false;
                } else {
                    input.parentElement.firstElementChild.classList.remove("text-danger");
                }
            });

            return complete;
        }

        function showStatus(statusMessage) {
            if (statusMessage) {
                statusContainer.innerText = statusMessage;
                statusContainer.classList.add("alert-success");
                statusContainer.classList.remove("d-none", "alert-warning");
            } else {
                statusContainer.classList.add("d-none");
            }
        }

        function showError(errorMessage) {
            if (errorMessage) {
                statusContainer.innerText = errorMessage;
                statusContainer.classList.add("alert-warning");
                statusContainer.classList.remove("d-none", "alert-success");
            } else {
                statusContainer.classList.add("d-none");
            }
        }

        async function showPreview() {
            if (requestingPreview) return;

            showStatus("Fetching preview image...");
            imgContainer.innerHTML = '<div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div>';

            if (!inputsComplete()) {
                return alert("All input fields must be complete");
            }

            try {
                requestingPreview = true;
                document.querySelector('#save-image').disabled = true;

                showStatus('Fetching map...');

                const mapImageResult = await fetch(`https://maps.googleapis.com/maps/api/staticmap?zoom=${zoomEl.value}&size=${widthEl.value}x${heightEl.value}&maptype=roadmap&markers=color:red|${locationAddress}&key=${apiKey}&style=feature:poi|visibility:off&scale=${scaleEl.value}`);

                if (!mapImageResult.ok) {
                    throw new Error(`${mapImageResult.status}: ${await mapImageResult.text()}`);
                }

                const imageBlob = await mapImageResult.blob();
                const dataBase64 = await new Promise(resolve => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.readAsDataURL(imageBlob);
                });
                imageBase64 = dataBase64.split(',')[1];

                imagePath = mapImageResult.url;

                const img = document.createElement('img');
                img.src = mapImageResult.url;
                img.className = 'img-fluid';

                imgContainer.innerHTML = '';
                imgContainer.appendChild(img);

                showStatus('New map acquired, displayed below.');

                document.querySelector('#save-image').disabled = false;
            } catch (e) {
                imgContainer.innerHTML = '';
                console.error(e);
                showError(`Error optimizing image: ${e}`);
            } finally {
                requestingPreview = false;
                ResetSpinners();
            }
        }

        async function saveImage() {
            if(uploadingAndOptimizingModal) {
                uploadingAndOptimizingModal.show();
            }
            try {
                const saveResponse = await fetch(savePath, {
                    headers: {
                        "Content-Type": "application/json"
                    },
                    method: 'post',
                    body: JSON.stringify(imageBase64)
                });

                showStatus(await saveResponse.json());
            } catch (e) {
                console.log(e);
                showError(`Error optimizing image. ${e.value}`);
            } finally {
                uploadingAndOptimizingModal.hide();
                ResetSpinners();
            }
        }
    </script>
}
