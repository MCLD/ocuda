@using Ocuda.Ops.Controllers.ViewModels.Home
@model Ocuda.Ops.Controllers.ViewModels.Home.IndexViewModel

@section header {
    @if (!string.IsNullOrEmpty(Model.SectionName))
    {
        <div class="d-flex justify-content-between align-items-top mb-2">
            <h1>
                @Model.SectionName
                @if (Model.SupervisorsOnly)
                {
                    <small class="text-muted">
                        (<span class="fa-solid fa-lock oc-section-locked"></span> Supervisors only)
                    </small>
                }
            </h1>
            <div class="pt-1 d-print-none">
                @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
                {
                    <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Section)"
                       asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                       asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                       asp-route-sectionslug="@Model.SectionSlug"
                       class="btn btn-sm btn-outline-primary mt-1 ms-2">
                        Management
                    </a>
                }
                @if (Model.SectionManager)
                {
                    <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.AddPost)"
                       asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                       asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                       asp-route-sectionSlug="@Model.SectionSlug"
                       class="btn btn-sm btn-outline-success mt-1 ms-2">
                        <span class="fa-solid fa-circle-plus"></span>
                        Add Post
                    </a>
                }
                @if (Model.LinkLibraries?.Where(_ => !_.IsFeatured).Count() == 1)
                {
                    @foreach (var linkLibrary in Model.LinkLibraries?.Where(_ => !_.IsFeatured))
                    {
                        <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Links)"
                           asp-area=""
                           asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                           asp-route-linkLibrarySlug="@linkLibrary.Slug"
                           asp-route-sectionSlug="@Model.SectionSlug"
                           class="btn btn-sm btn-outline-dark mt-1 ms-2">@linkLibrary.Name</a>
                    }
                }
                else if (Model.LinkLibraries?.Where(_ => !_.IsFeatured).Count() > 1)
                {
                    <div class="btn-group mt-1 ms-2">
                        <button class="btn btn-sm btn-outline-dark dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Links
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (var linkLibrary in Model.LinkLibraries?.Where(_ => !_.IsFeatured).OrderBy(_ => _.Name))
                            {
                                <li>
                                    <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Links)"
                                       asp-area=""
                                       asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                       asp-route-linkLibrarySlug="@linkLibrary.Slug"
                                       asp-route-sectionSlug="@Model.SectionSlug"
                                       class="dropdown-item">@linkLibrary.Name</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                @if (Model.FileLibraries?.Where(_ => !_.IsFeatured).Count() == 1)
                {
                    @foreach (var fileLibrary in Model.FileLibraries?.Where(_ => !_.IsFeatured))
                    {
                        <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                           asp-area=""
                           asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                           asp-route-fileLibrarySlug="@fileLibrary.Slug"
                           asp-route-sectionSlug="@Model.SectionSlug"
                           class="btn btn-sm btn-outline-dark mt-1 ms-2">@fileLibrary.Name</a>
                    }
                }
                else if (Model.FileLibraries?.Where(_ => !_.IsFeatured).Count() > 1)
                {
                    <div class="btn-group mt-1 ms-2">
                        <button class="btn btn-sm btn-outline-dark dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Files
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (var fileLibrary in Model.FileLibraries?.Where(_ => !_.IsFeatured).OrderBy(_ => _.Name))
                            {
                                <li>
                                    <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                                       asp-area=""
                                       asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                       asp-route-fileLibrarySlug="@fileLibrary.Slug"
                                       asp-route-sectionSlug="@Model.SectionSlug"
                                       class="dropdown-item">@fileLibrary.Name</a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }
}
@if (!(Model.Posts?.Count > 0) && !(Model.FileLibraries?.Count > 0) && !(Model.LinkLibraries?.Count > 0))
{
    <div class="row">
        <div class="col-12 col-md-8 offset-md-2 col-lg-4 offset-lg-4">
            <div class="alert alert-info">This section appears to have no content.</div>
        </div>
    </div>
}
<div class="row">
    @if (Model.Posts?.Count > 0)
    {
        <div class="@Model.PostClasses">
            @foreach (var post in Model.Posts)
            {
                <div class="card @post.BorderColor mb-4">
                    <div class="card-header d-flex align-content-center @post.TextColor">
                        <div class="flex-grow-1 lead fw-bold">
                            <a name="@post.Slug">@post.Title</a>
                        </div>
                        @if (post.ShowOnHomePage && !string.IsNullOrEmpty(Model.SectionName))
                        {
                            <div>
                                <span class="fa-solid fa-house fa-fw text-muted mt-1"
                                      title="This post is shown on the Intranet home page."></span>
                            </div>
                        }
                        @if (post.IsPinned)
                        {
                            <div>
                                <span class="fa-solid fa-map-pin fa-fw mt-1"
                                      title="This post is pinned to the top until @post.PinnedUntil."></span>
                            </div>
                        }
                    </div>
                    @if (Model.SectionManager)
                    {
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item p-1 m-0 bg-light d-flex">
                                <span class="flex-grow-1">
                                    <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.EditPost)"
                                       asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                                       asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                                       asp-route-postSlug="@post.Slug"
                                       asp-route-sectionSlug="@Model.SectionSlug"
                                       asp-route-page="@Model.CurrentPage"
                                       class="btn btn-sm btn-outline-secondary ms-3">
                                        <span class="fa-solid fa-pencil fa-fw"
                                              title="Edit post"></span>
                                        Edit Post
                                    </a>
                                </span>
                                @if (post.UpdatedAt.HasValue)
                                {
                                    <em class="me-3 text-muted" title="@post.UpdatedAt.Value">
                                        <small>
                                            Last update
                                            @if (post.UpdatedBy.HasValue
                                                && !string.IsNullOrEmpty(post.UpdatedByName))
                                            {
                                                @:by
                                                <a asp-controller="@ProfileController.Name"
                                                   asp-action="@nameof(ProfileController.Index)"
                                                   asp-route-id="@post.UpdatedByUsername">@post.UpdatedByName</a>
                                            }
                                            @post.UpdatedAgo
                                        </small>
                                    </em>
                                }
                            </li>
                        </ul>
                    }
                    <div class="card-body pb-0 pt-3">
                        @Html.Raw(post.Content)
                    </div>
                    <div class="card-footer d-flex flex-wrap py-1">
                        <div class="flex-grow-1 me-2">
                            <em>
                                <small class="text-muted">
                                    Posted by
                                    @if (!string.IsNullOrEmpty(post.CreatedByUsername))
                                    {
                                        <a asp-controller="@ProfileController.Name"
                                           asp-action="@nameof(ProfileController.Index)"
                                           asp-route-id="@post.CreatedByUsername">@post.CreatedByName</a>
                                    }
                                    else
                                    {
                                        @post.CreatedByName
                                    }
                                    @if (!string.IsNullOrEmpty(post.SectionSlug)
                                        && !string.IsNullOrEmpty(post.SectionName))
                                    {
                                        @:in
                                        <a asp-controller="@HomeController.Name"
                                           asp-action="@nameof(HomeController.SectionIndex)"
                                           asp-route-slug="@post.SectionSlug">@post.SectionName</a>
                                    }
                                </small>
                            </em>
                        </div>
                        @if (post.PublishedAt.HasValue)
                        {
                            <span title="@post.PublishedAgo">
                                <em>
                                    <small class="text-muted">
                                        @post.PublishedAt.Value.ToString("f")
                                    </small>
                                </em>
                            </span>
                        }
                        else
                        {
                            <em><small class="text-muted">draft, not published</small></em>
                        }
                    </div>
                </div>
            }
            <nav paginate="@Model"></nav>
        </div>
    }
    @if (Model.LinkLibraries?.Any(_ => _.IsFeatured) == true
        || Model.FileLibraries?.Any(_ => _.IsFeatured) == true)
    {
        <div class="@Model.LibraryClasses">
            @if (Model.LinkLibraries?.Any(_ => _.IsFeatured) == true)
            {
                @foreach (var linkLibrary in Model.LinkLibraries.Where(_ => _.IsFeatured && _.Links.Count > 0))
                {
                    <div class="card mb-2">
                        <div class="card-header">
                            <div class="d-flex align-content-center">
                                <div class="flex-grow-1 lead fw-bold">
                                    @linkLibrary.Name
                                </div>
                                <div>
                                    <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Links)"
                                       asp-area=""
                                       asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                       asp-route-linkLibrarySlug="@linkLibrary.Slug"
                                       asp-route-sectionSlug="@Model.SectionSlug"
                                       class="btn btn-sm btn-outline-secondary">
                                        <span class="fa-solid fa-list-check fa-fw"
                                              title="View this link library."></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="card-body py-1 d-flex flex-column">
                            @foreach (var link in linkLibrary.Links)
                            {
                                <div class="mb-1">
                                    <a href="@link.Url" class="text-decoration-none">
                                        @if (string.IsNullOrEmpty(link.Icon))
                                        {
                                            <span class="fa-solid fa-angle-right fa-fw pe-1"></span>
                                        }
                                        else
                                        {
                                            <span class="@link.Icon fa-fw pe-1"></span>
                                        }
                                    </a>
                                    <a href="@link.Url"><small>@link.Name</small></a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            @if (Model.FileLibraries?.Any() == true)
            {
                @foreach (var fileLibrary in Model.FileLibraries.Where(_ => _.IsFeatured && _.Files.Count > 0))
                {
                    <div class="card mb-2">
                        <div class="card-header d-flex align-content-center">
                            <div class="flex-grow-1">
                                <span class="lead fw-bold">@fileLibrary.Name</span>
                                @if (fileLibrary.TotalFilesInLibrary > fileLibrary.Files.Count)
                                {
                                    <small class="ms-1">
                                        <em>
                                            (@fileLibrary.TotalFilesInLibrary total,
                                            @fileLibrary.Files.Count shown)
                                        </em>
                                    </small>
                                }
                            </div>
                            <div>
                                <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                                   asp-area=""
                                   asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                   asp-route-fileLibrarySlug="@fileLibrary.Slug"
                                   asp-route-sectionSlug="@Model.SectionSlug"
                                   class="btn btn-sm btn-outline-secondary">
                                    <span class="fa-solid fa-list-check fa-fw"
                                          title="View this file library."></span>
                                </a>
                            </div>
                        </div>
                        @if (fileLibrary.SortOrder == FileLibrarySort.DocumentDateMonthDescending)
                        {
                            <div class="card-body py-1 d-flex flex-column">
                                @foreach (var yearFiles in IndexViewModel.GetByFileYear(fileLibrary.Files))
                                {
                                    @foreach (var file in yearFiles.Value.OrderByDescending(_ => _.FileDate).ThenBy(_ => _.Name))
                                    {
                                        <div class="mb-1">
                                            <a asp-action="@nameof(HomeController.GetFile)"
                                               asp-route-libraryId="@fileLibrary.Id"
                                               asp-route-fileId="@file.Id"
                                               class="text-decoration-none">
                                                @if (string.IsNullOrEmpty(file.FileType?.Icon))
                                                {
                                                    <span class="fa-regular fa-file fa-fw pe-1"></span>
                                                }
                                                else
                                                {
                                                    <span class="@file.FileType.Icon fa-fw pe-1"></span>
                                                }
                                            </a>
                                            <a asp-action="@nameof(HomeController.GetFile)"
                                               asp-route-libraryId="@fileLibrary.Id"
                                               asp-route-fileId="@file.Id"><small>@file.Name</small></a>
                                            <small class="ms-1">
                                                @if (string.IsNullOrEmpty(file.Size))
                                                {
                                                    <span class="text-danger fa-solid fa-triangle-exclamation"
                                                          title="This file appears to be missing."></span>
                                                }
                                                else
                                                {
                                                    <em>(@file.Size)</em>
                                                }
                                            </small>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <div class="card-body py-1 d-flex flex-column">
                                @foreach (var file in fileLibrary.Files)
                                {
                                    <div class="mb-1">
                                        <a asp-action="@nameof(HomeController.GetFile)"
                                           asp-route-libraryId="@fileLibrary.Id"
                                           asp-route-fileId="@file.Id"
                                           class="text-decoration-none">
                                            @if (string.IsNullOrEmpty(file.FileType?.Icon))
                                            {
                                                <span class="fa-regular fa-file fa-fw pe-1"></span>
                                            }
                                            else
                                            {
                                                <span class="@file.FileType.Icon fa-fw pe-1"></span>
                                            }
                                        </a>
                                        <a asp-action="@nameof(HomeController.GetFile)"
                                           asp-route-libraryId="@fileLibrary.Id"
                                           asp-route-fileId="@file.Id"><small>@file.Name</small></a>
                                        <small class="ms-1">
                                            @if (string.IsNullOrEmpty(file.Size))
                                            {
                                                <span class="text-danger fa-solid fa-triangle-exclamation"
                                                      title="This file appears to be missing."></span>
                                            }
                                            else
                                            {
                                                <em>(@file.Size)</em>
                                            }
                                        </small>
                                    </div>
                                }
                            </div>
                        }
                        @if (fileLibrary.TotalFilesInLibrary > fileLibrary.Files.Count)
                        {
                            <div class="card-footer">
                                <a asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                   asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                                   asp-area=""
                                   asp-route-sectionSlug="@Model.SectionSlug"
                                   asp-route-fileLibrarySlug="@fileLibrary.Slug">More files...</a>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
</div>
