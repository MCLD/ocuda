@using Ocuda.Ops.Controllers.Areas.ContentManagement
@model Ocuda.Ops.Controllers.ViewModels.Home.LinkLibraryViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Link Library
            <small class="text-muted d-print-block">
                @Model.SectionName / @Model.LinkLibrary.Name
            </small>
        </h1>
        <div class="pt-1 d-print-none">
            @if (Model.HasAdminRights)
            {
                <button class="btn btn-outline-success btn-sm mt-1 ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#listAddModal">
                    <span class="fa-solid fa-link fa-fw" aria-hidden="true"></span>
                    Add link
                </button>
            }
            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.SectionIndex)"
               asp-area=""
               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
               asp-route-slug="@Model.SectionSlug"
               class="btn btn-outline-dark btn-sm mt-1 ms-2">Back</a>
        </div>
    </div>
}

<div class="row pt-2">
    <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
        <table class="table table-sm table-bordered table-hover">
            <thead>
                <tr>
                    <th>Link</th>
                    @if (Model.HasAdminRights)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Links.Count > 0)
                {
                    @foreach (var link in Model.Links)
                    {
                        <tr>
                            <td class="align-middle px-2">
                                <a class="text-decoration-none"
                                   href="@link.Url"
                                   target="_blank">
                                    @if (!string.IsNullOrEmpty(link.Icon))
                                    {
                                        <span class="@link.Icon fa-fw pe-1"></span>
                                    }
                                    else
                                    {
                                        <span class="fa-solid fa-angle-right fa-fw pe-1"></span>
                                    }
                                </a>
                                <a href="@link.Url"
                                   target="_blank">@link.Name</a>
                            </td>
                            @if (Model.HasAdminRights)
                            {
                                <td class="align-middle">
                                    <div class="d-flex justify-content-center">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary mx-1"
                                                data-bs-target="#listEditModal"
                                                data-bs-toggle="modal"
                                                data-icon="@link.Icon"
                                                data-id="@link.Id"
                                                data-name="@link.Name"
                                                data-url="@link.Url"
                                                title="Edit link">
                                            <span class="fa-solid fa-pen-to-square fa-fw"
                                                  aria-hidden="true"></span>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger mx-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@link.Id"
                                                data-name="@link.Name"
                                                data-url="@link.Url"
                                                title="Delete link">
                                            <span class="fa-regular fa-circle-xmark fa-fw"
                                                  aria-hidden="true"></span>
                                        </button>
                                    </div>

                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3">No Links in Library</td>
                    </tr>
                }
            </tbody>
        </table>
        <nav paginate="@Model"></nav>
    </div>
</div>

@if (Model.HasAdminRights)
{
    <div aria-labelledby="listModalLabel"
         class="modal fade"
         data-bs-backdrop="static"
         id="listAddModal"
         role="dialog"
         tabindex="-1">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addModalTitle">Add Link</h5>
                    <button aria-label="Close"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            type="button"></button>
                </div>
                <form asp-action="@nameof(SectionController.AddLinkToLibrary)"
                      asp-area="@SectionController.Area"
                      asp-controller="@SectionController.Name"
                      method="post"
                      role="form"
                      enctype="multipart/form-data">
                    <div class="modal-body">
                        <input asp-for="SectionSlug"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.SectionSlug" />
                        <input asp-for="SectionName"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.SectionName" />
                        <input asp-for="LinkLibrarySlug"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Slug" />
                        <input asp-for="LinkLibraryId"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Id" />
                        <input asp-for="LinkLibraryName"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Name" />
                        <input asp-for="Link.Name" autocomplete="off" formgroup />
                        <input asp-for="Link.Url" autocomplete="off" formgroup />
                        @if (Model.IsSiteManager)
                        {
                            <input asp-for="Link.Icon"
                                   autocomplete="off"
                                   class="form-control icon-picker"
                                   formgroup
                                   type="text" />
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-dark"
                                data-bs-dismiss="modal"
                                type="button">
                            Cancel
                        </button>
                        <button class="btn btn-outline-success"
                                type="submit"
                                value="Submit">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div aria-labelledby="listModalLabel"
         class="modal"
         data-bs-backdrop="static"
         id="listEditModal"
         role="dialog"
         tabindex="-1">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalTitle">Edit Link</h5>
                    <button aria-label="Close"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            type="button"></button>
                </div>
                <form asp-action="@nameof(SectionController.UpdateLinkFromLibrary)"
                      asp-area="@SectionController.Area"
                      asp-controller="@SectionController.Name"
                      method="post"
                      role="form"
                      enctype="multipart/form-data">
                    <div class="modal-body">
                        <input asp-for="SectionSlug"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.SectionSlug" />
                        <input asp-for="SectionName"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.SectionName" />
                        <input asp-for="LinkLibrarySlug"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Slug" />
                        <input asp-for="LinkLibraryId"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Id" />
                        <input asp-for="LinkLibraryName"
                               autocomplete="off"
                               type="hidden"
                               value="@Model.LinkLibrary.Name" />
                        <input asp-for="Link.Id" autocomplete="off" type="hidden" />
                        <input asp-for="Link.Name" autocomplete="off" formgroup />
                        <input asp-for="Link.Url" autocomplete="off" formgroup />
                        @if (Model.IsSiteManager)
                        {
                            <input asp-for="Link.Icon"
                                   class="form-control icon-picker"
                                   type="text"
                                   formgroup
                                   autocomplete="off" />
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-dark"
                                data-bs-dismiss="modal"
                                type="button">
                            Cancel
                        </button>
                        <button class="btn btn-outline-primary"
                                value="Submit"
                                type="submit">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div aria-labelledby="deleteModalLabel"
         class="modal fade"
         data-bs-backdrop="static"
         id="deleteModal"
         role="dialog"
         tabindex="-1">
        <div class="modal-dialog" role="document">
            <form asp-action="@nameof(SectionController.DeleteLinkFromLibrary)"
                  asp-area="@SectionController.Area"
                  asp-controller="@SectionController.Name"
                  class="d-inline"
                  method="post"
                  role="form">
                <input asp-for="SectionSlug"
                       autocomplete="off"
                       type="hidden"
                       value="@Model.SectionSlug" />
                <input asp-for="SectionName"
                       autocomplete="off"
                       type="hidden"
                       value="@Model.SectionName" />
                <input asp-for="LinkLibrarySlug"
                       autocomplete="off"
                       type="hidden"
                       value="@Model.LinkLibrary.Slug" />
                <input asp-for="LinkLibraryId"
                       autocomplete="off"
                       type="hidden"
                       value="@Model.LinkLibrary.Id" />
                <input asp-for="LinkLibraryName"
                       autocomplete="off"
                       type="hidden"
                       value="@Model.LinkLibrary.Name" />
                <input asp-for="Link.Id" type="hidden" />
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Delete Feature</h5>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button"></button>
                    </div>
                    <div class="modal-body d-flex">
                        <div class="text-danger">
                            <span aria-hidden="true"
                                  class="fa-solid fa-triangle-exclamation fa-lg fa-fw me-3"></span>
                        </div>
                        <div class="d-flex-grow-1">
                            <p class="mb-0">
                                Are you sure you want to delete this link:
                                <strong><span id="modal-text"></span></strong>?
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-dark me-1"
                                data-bs-dismiss="modal"
                                type="button">
                            Cancel
                        </button>
                        <button class="btn btn-outline-danger float-end"
                                aria-label="Confirm"
                                id="delButton"
                                type="submit"
                                value="Submit"
                                button-spinner>
                            Delete
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section scripts {
    @if (Model.HasAdminRights)
    {
        <script>
            $("#deleteModal").on("show.bs.modal", function (e) {
                let button = $(e.relatedTarget);
                let id = button.data("id");
                let name = button.data("name");
                let url = button.data("url");
                $(this).find("#modal-text").text(`${name} (${url})`);
                $(this).find("#Link_Id").val(id);
            });

            $("#listEditModal").on("show.bs.modal", function (e) {
                let button = $(e.relatedTarget);
                let icon = button.data("icon");
                let id = button.data("id");
                let name = button.data("name");
                let url = button.data("url");
                $(this).find("#Link_Id").val(id);
                $(this).find("#Link_Icon").val(icon);
                $(this).find("#Link_Name").val(name);
                $(this).find("#Link_Url").val(url);
            });
        </script>
    }
    <script>
        $(document).ready(function () {
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
}
