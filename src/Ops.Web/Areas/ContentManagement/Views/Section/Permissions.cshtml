@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.PermissionsViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Section Management
            <small class="text-muted d-print-block">
                @Model.Name
            </small>
        </h1>
        <div class="pt-1 d-print-none">
            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Section)"
               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
               asp-route-sectionSlug="@Model.Slug"
               class="btn btn-outline-dark btn-sm mt-1 ms-2">Back</a>
        </div>
    </div>
}

<div class="row">
    <div class="col-12 col-sm-10 offset-sm-1">
        <div class="alert alert-primary">
            Use this interface to assign Section Management permissions to Permission Groups (which
            typically align with Active Directory Security Groups). Section Management rights:
            <ul>
                <li>Add, edit, and delete posts</li>
                <li>Add, edit, and delete links in link libraries</li>
                <li>Add, edit, replace, and delete files (and thumbnails) in file libraries</li>
            </ul>
        </div>
    </div>
</div>

<div class="row pt-1">
    <div class="col-12 col-sm-6">
        <div class="card">
            <div class="card-header px-3">
                Available Groups
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.AvailableGroups?.Count > 0)
                {
                    foreach (var availableGroup in Model.AvailableGroups)
                    {
                        <li class="list-group-item px-3 py-2">
                            <form asp-controller="@SectionController.Name"
                                  asp-action="@(nameof(SectionController.AddPermissionGroup))"
                                  asp-route-slug="@Model.Slug"
                                  asp-route-permissionGroupId="@availableGroup.Key">
                                <span class="d-inline-block mt-1">@availableGroup.Value</span>
                                <button class="btn btn-outline-success float-end">
                                    <span class="fa-solid fa-circle-plus"></span>
                                </button>
                            </form>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">No groups available.</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="card">
            <div class="card-header px-3">
                Assigned Groups
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.AssignedGroups?.Count > 0)
                {
                    foreach (var availableGroup in Model.AssignedGroups)
                    {
                        <li class="list-group-item px-3 py-2">
                            <form asp-controller="@SectionController.Name"
                                  asp-action="@(nameof(SectionController.RemovePermissionGroup))"
                                  asp-route-slug="@Model.Slug"
                                  asp-route-permissionGroupId="@availableGroup.Key">
                                <span class="d-inline-block mt-1">@availableGroup.Value</span>
                                <button class="btn btn-outline-danger float-end">
                                    <span class="fa-solid fa-circle-minus"></span>
                                </button>
                            </form>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">No groups assigned.</li>
                }
            </ul>
        </div>
    </div>
</div>
