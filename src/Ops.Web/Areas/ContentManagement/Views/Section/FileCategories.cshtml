@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.AssignmentViewModel
@using Ocuda.Ops.Controllers.Areas.ContentManagement

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            File Category Assignment
            <small class="text-muted d-print-block">
                @Model.FileName
            </small>
        </h1>
        <div class="pt-1 d-print-none">
            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
               asp-area=""
               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
               asp-route-sectionSlug="@Model.SectionSlug"
               asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
               class="btn btn-outline-dark btn-sm mt-1 ms-2">Back</a>
        </div>
    </div>
}
<div class="row">
    <div class="col-12 col-sm-10 offset-sm-1">
        <div class="alert alert-primary">
            Assign one or more categories to this file.
        </div>
    </div>
</div>
<div class="row pt-1">
    <div class="col-12 col-sm-6">
        <div class="card">
            <div class="card-header fw-bold px-3">
                Available Categories <small><em>(@(Model.Available?.Count ?? 0))</em></small>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Available.Count > 0)
                {
                    foreach (var availableGroup in Model.Available)
                    {
                        <form asp-action="@nameof(SectionController.AddCategoryToFile)"
                              asp-route-categoryId="@availableGroup.Key"
                              asp-route-fileId="@Model.FileId"
                              asp-route-sectionSlug="@Model.SectionSlug">
                            <li class="list-group-item px-3 py-2 d-flex">
                                <div class="flex-grow-1">
                                    @availableGroup.Value
                                </div>
                                <div>
                                    <button button-spinner class="btn btn-sm btn-outline-success">
                                        <span class="fa-solid fa-circle-plus fa-fw"></span>
                                    </button>
                                </div>
                            </li>
                        </form>
                    }
                }
                else
                {
                    <li class="list-group-item">None available.</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="card">
            <div class="card-header fw-bold px-3">
                Assigned Categories <small><em>(@(Model.Assigned?.Count ?? 0))</em></small>
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Assigned?.Count > 0)
                {
                    foreach (var availableGroup in Model.Assigned)
                    {
                        <form asp-action="@nameof(SectionController.RemoveCategoryFromFile)"
                              asp-route-categoryId="@availableGroup.Key"
                              asp-route-fileId="@Model.FileId"
                              asp-route-sectionSlug="@Model.SectionSlug">
                            <li class="list-group-item px-3 py-2 d-flex">
                                <div class="flex-grow-1">@availableGroup.Value</div>
                                <button button-spinner class="btn btn-sm btn-outline-danger">
                                    <span class="fa-solid fa-circle-minus fa-fw"></span>
                                </button>
                            </li>
                        </form>
                    }
                }
                else
                {
                    <li class="list-group-item">None assigned.</li>
                }
            </ul>
        </div>
    </div>
</div>
