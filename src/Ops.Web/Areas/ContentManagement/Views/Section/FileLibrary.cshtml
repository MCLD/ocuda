@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.FileLibraryManagementViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            File Library
            <small class="text-muted d-print-block">
                @Model.SectionName / @Model.DisplayName
            </small>
        </h1>
        <div class="d-print-none">
            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Section)"
               asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
               asp-route-sectionSlug="@Model.SectionSlug"
               class="btn btn-sm btn-outline-dark mt-1 ms-2">Back</a>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.SaveFileLibrary)"
              asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
              asp-route-sectionSlug="@Model.SectionSlug"
              method="post">
            <div class="card mb-4">
                <div class="card-header lead fw-bold">
                    File Library Configuration
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name"
                              class="validation-message text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label"></label>
                        <small class="ms-2">
                            <em>
                                Changing the slug may break existing links
                            </em>
                        </small>
                        <input asp-for="Slug"
                               class="form-control"
                               data-oc-slugify-from="Name">
                        <span asp-validation-for="Slug"
                              class="validation-message text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="SortOrder" class="form-label"></label>
                        <select asp-for="SortOrder"
                                asp-items="Model.SortOrderOptions"
                                class="form-select">
                        </select>
                        <span asp-validation-for="SortOrder"
                              class="validation-message text-danger"></span>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                        <label asp-for="IsFeatured" class="form-label"></label>
                    </div>
                    @if (Model.FileCount > 0)
                    {
                        <div class="alert alert-info px-2 py-1 mt-1 mb-0">
                            This file library has @Model.FileCount files in it. If you wish to
                            delete it you must first
                            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                               asp-area=""
                               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                               asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
                               asp-route-sectionSlug="@Model.SectionSlug">delete those files</a>.
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-end">
                    @if (!Model.IsNew)
                    {
                        <button class="btn btn-outline-danger btn-sm me-2"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                            @(Model.FileCount == 0 ? null : "disabled='disabled'")
                                type="button">
                            Delete File Library
                        </button>
                    }
                    <button class="btn btn-outline-primary btn-sm"
                            type="submit">
                        Save
                    </button>
                </div>
            </div>
        </form>
    </div>
    @if (!Model.IsNew)
    {
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header d-flex">
                    <div class="flex-grow-1 lead fw-bold">Allowed Upload Types</div>
                    <div>
                        <button class="btn btn-outline-success btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#addFileTypeModal">
                            <span class="fa-solid fa-circle-plus fa-fw"></span>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.AssignedFileTypes?.Any() == true)
                    {
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>File Type</th>
                                    <th class="d-flex justify-content-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var type in Model.AssignedFileTypes.OrderBy(_ => _.Extension))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-inline" style="width: 2rem;">
                                                <span class="@type.Icon fa-fw"></span>
                                            </div>
                                            <code class="fs-6">@type.Extension</code>
                                        </td>
                                        <td class="d-flex justify-content-end">
                                            <form asp-action="@nameof(SectionController.RemoveLibraryFileType)"
                                                  asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
                                                  asp-route-sectionSlug="@Model.SectionSlug"
                                                  asp-route-fileTypeId="@type.Id"
                                                  method="post">
                                                <button class="btn btn-outline-danger btn-sm"
                                                        type="submit">
                                                    <span class="fa-regular fa-circle-xmark fa-fw"></span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col col-md-10 offset-md-1 col-lg-6 offset-lg-3">
                                <div class="alert alert-warning mb-0 text-center">
                                    No file types are allowed in this file library.
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
        {
            <div class="col-md-6">
                <div class="card mb-4">
                    <div class="card-header d-flex">
                        <div class="flex-grow-1 lead fw-bold">Permissions</div>
                    </div>
                    <div class="card-body">
                        <a class="btn btn-outline-primary btn-sm ms-2 my-1"
                           asp-area="@SectionController.Area"
                           asp-controller="@SectionController.Name"
                           asp-action="@nameof(SectionController.ReplaceFilePermissions)"
                           asp-route-sectionSlug="@Model.SectionSlug"
                           asp-route-fileLibrarySlug="@Model.FileLibrarySlug">
                            <span class="fa-solid fa-user-plus fa-fw"></span>
                            Replace File Permissions
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.FileCount == 0 && !Model.IsNew)
{
    <form asp-action="@nameof(SectionController.DeleteFileLibrary)"
          asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
          asp-route-sectionSlug="@Model.SectionSlug"
          method="post">
        <div aria-hidden="true"
             aria-labelledby="deleteLabel"
             class="modal fade"
             data-bs-backdrop="static"
             data-bs-keyboard="false"
             id="deleteModal"
             tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="deleteLabel">Delete file library</h1>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button">
                        </button>
                    </div>
                    <div class="modal-body d-flex">
                        <div class="text-danger">
                            <span aria-hidden="true"
                                  class="fa-solid fa-triangle-exclamation fa-lg fa-fw me-3"></span>
                        </div>
                        <div class="d-flex-grow-1">
                            <p class="mb-0">
                                Are you sure you want to delete this file library?
                            </p>
                        </div>
                    </div>                    <div class="modal-footer">
                    <button class="btn btn-outline-secondary"
                            data-bs-dismiss="modal"
                            type="button">
                        Close
                    </button>
                    <button class="btn btn-outline-danger" type="submit">Delete</button>
                </div>
            </div>
        </div>
    </div>
</form>
}

<div aria-hidden="true"
     aria-labelledby="addFileTypeLabel"
     class="modal fade"
     data-bs-backdrop="static"
     data-bs-keyboard="false"
     id="addFileTypeModal"
     tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="addFileTypeLabel">Add file type for upload</h1>
            </div>
            <div class="modal-body" id="addFileTypeContent">
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary"
                        data-bs-dismiss="modal"
                        id="addFileTypeCloseButton"
                        type="button">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@if (!Model.IsNew)
{
    <form asp-action="@nameof(SectionController.AddTypeToLibrary)"
            asp-route-fileLibrarySlug="@Model.FileLibrarySlug"
            asp-route-sectionSlug="@Model.SectionSlug"
            class="d-none"
            id="addFileTypeForm"
            method="POST">
        <input type="hidden" name="fileTypeId" id="fileTypeId" />
    </form>
}

@section Scripts {
    @if (!Model.IsNew)
    {
        <script type="text/javascript">
            const addFileTypeCloseButton = document.getElementById('addFileTypeCloseButton');
            const addFileTypeContent = document.getElementById('addFileTypeContent');
            const addFileTypeForm = document.getElementById('addFileTypeForm');
            const addFileTypeModal = document.getElementById('addFileTypeModal');
            const dialogSpinner = '<div class="fa-3x text-center"><span class="fa-solid fa-spinner fa-spin"></span></div>';
            const fileTypeLink = "@Model.GetAvailableTypesLink";

            addFileTypeModal.addEventListener('show.bs.modal', event => {
                addFileTypeCloseButton.setAttribute('disabled', 'disabled');
                addFileTypeContent.innerHTML = dialogSpinner;
                fetch(new URL(`${location.origin}${fileTypeLink}`), { method: 'GET' })
                    .then((response) => response.json())
                    .then((jsonResponse) => {
                        const html = [];
                        jsonResponse.items.forEach((e) => {
                            html.push('<button class="btn btn-outline-primary add-type-button m-1" ');
                            html.push(`data-typeid="${e.id}">`)
                            html.push(`<span class="fa-fw ${e.icon}"></span> ${e.extension}`);
                            html.push('</button>');
                        });
                        addFileTypeContent.innerHTML = html.join('');
                        const elements = document.getElementsByClassName('add-type-button');
                        Array.from(elements).forEach(function(element) {
                            element.addEventListener('click', addType);
                        });
                    })
                    .catch((error) => {
                        addFileTypeContent.innerHTML = `<div class="alert alert-danger">An error occurred: ${error}</div>`;
                    })
                    .finally(() => {
                        addFileTypeCloseButton.removeAttribute('disabled');
                    });
            });

            function addType(e) {
                addFileTypeCloseButton.setAttribute('disabled', 'disabled');
                addFileTypeContent.innerHTML = dialogSpinner;
                document
                    .getElementById('fileTypeId')
                    .setAttribute('value', e.currentTarget.dataset.typeid);
                addFileTypeForm.submit();
            }
        </script>
    }
}
