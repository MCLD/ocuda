@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.SectionIndexViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Sections
        </h1>
        <div class="pt-1 d-print-none">
            @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
            {
                <button class="btn btn-sm btn-outline-success mt-1 ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addSection">
                    <span class="fa-solid fa-circle-plus" aria-hidden="true"></span>
                    Add Section
                </button>
                <form action="@Url.Action(nameof(SectionController.ClearSectionCache))"
                      class="d-inline"
                      method="post"
                      role="form">
                    <button class="btn btn-sm btn-outline-warning mt-1 ms-2"
                            type="submit">
                        Clear cache
                    </button>
                </form>
            }
            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Index)"
               asp-area=""
               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
               class="btn btn-sm btn-outline-dark mt-1 ms-2">Back</a>
        </div>
    </div>
}
<div class="row">
    @if (Model.Sections == null || Model.Sections.Count == 0)
    {
        <div class="row">
            <div class="col-12 col-md-8 offset-md-2">
                <div class="alert alert-info mt-2">No sections available.</div>
            </div>
        </div>
    }
    else
    {
        @foreach (var opsSection in Model.Sections)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card mb-4">
                    <div class="card-header d-flex">
                        <div class="flex-grow-1 lead fw-bold">
                            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.SectionIndex)"
                               asp-area=""
                               asp-controller="@HomeController.Name"
                               asp-route-slug="@opsSection.Slug">
                                @opsSection.Name
                            </a>
                        </div>
                        @if (!string.IsNullOrEmpty(opsSection.Icon))
                        {
                            <div>
                                <span class="@opsSection.Icon fa-fw"></span>
                            </div>
                        }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm mb-0">
                            <tr>
                                <th class="px-3 py-2">File libraries</th>
                                <th class="px-3 py-2">Link libraries</th>
                                <th class="px-3 py-2">Posts</th>
                            </tr>
                            <tr>
                                <td class="px-3 py-2">@opsSection.FileLibraryCount</td>
                                <td class="px-3 py-2">@opsSection.LinkLibraryCount</td>
                                <td class="px-3 py-2">@opsSection.PostCount</td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-footer d-print-none border-top-0">
                        <a asp-action="@nameof(SectionController.Section)"
                           asp-route-sectionslug="@opsSection.Slug"
                           class="btn btn-outline-primary btn-sm me-1">
                            <span class="fa-solid fa-wrench fa-fw"></span>
                            Admin
                        </a>
                        @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
                        {
                            <a asp-action="@nameof(SectionController.Permissions)"
                               asp-route-slug="@opsSection.Slug"
                               class="btn btn-outline-primary btn-sm me-1">
                                <span class="fa-solid fa-user-plus fa-fw"></span>
                                Permissions
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
{
    <form asp-action="@nameof(SectionController.AddSection)">
        <div aria-hidden="true"
             aria-labelledby="addSectionLabel"
             class="modal fade"
             data-bs-backdrop="static"
             data-bs-keyboard="false"
             id="addSection"
             tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="addSectionLabel">Add Section</h1>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="SectionName" class="form-label"></label>
                            <input asp-for="SectionName" class="form-control" type="text" />
                            <span asp-validation-for="SectionName"
                                  class="validation-message text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SectionSlug" class="form-label"></label>
                            <input asp-for="SectionSlug"
                                   class="form-control"
                                   data-oc-slugify-from="SectionName"
                                   type="text" />
                            <span asp-validation-for="SectionSlug"
                                  class="validation-message text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SectionIcon" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="SectionIcon" class="form-control" type="text" />
                                <span class="input-group-text">
                                    <span id="iconPreview" style="min-width: 1.1rem;"></span>
                                </span>
                            </div>
                            <span asp-validation-for="SectionIcon"
                                  class="validation-message text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SupervisorsOnly" class="form-label"></label>
                            <select asp-for="SupervisorsOnly" class="form-select">
                                <option value="False" selected>No</option>
                                <option value="True">Yes</option>
                            </select>
                            <span asp-validation-for="SupervisorsOnly"
                                  class="validation-message text-danger"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                                type="button">
                            Close
                        </button>
                        <button class="btn btn-outline-success"
                                type="submit">
                            Add Section
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
{
    <script>
        const iconPreview = document.getElementById("iconPreview");
        const iconField = document.getElementById("SectionIcon");
        iconField.addEventListener("blur", (event) => {
            console.info("Event: %o", event);
            iconPreview.setAttribute("class", event.target.value);
            iconPreview.addClass("fa-fw");
        });
    </script>
}
