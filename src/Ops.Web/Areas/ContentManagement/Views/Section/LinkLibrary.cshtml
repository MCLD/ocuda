@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.LinkLibraryManagementViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Link Library
            <small class="text-muted d-print-block">
                @Model.SectionName / @Model.DisplayName
            </small>
        </h1>
        <div class="d-print-none">
            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Section)"
               asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
               asp-route-sectionSlug="@Model.SectionSlug"
               class="btn btn-sm btn-outline-dark mt-1 ms-2">Back</a>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.SaveLinkLibrary)"
              asp-route-linkLibrarySlug="@Model.LinkLibrarySlug"
              asp-route-sectionSlug="@Model.SectionSlug"
              method="post">
            <div class="card mb-4">
                <div class="card-header lead fw-bold">
                    Link Library Configuration
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control">
                        <span asp-validation-for="Name"
                              class="validation-message text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label"></label>
                        <small class="ms-2">
                            <em>
                                Changing the slug may break existing links
                            </em>
                        </small>
                        <input asp-for="Slug"
                               class="form-control"
                               data-oc-slugify-from="Name">
                        <span asp-validation-for="Slug"
                              class="validation-message text-danger"></span>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                        <label asp-for="IsFeatured" class="form-label"></label>
                    </div>
                    @if (Model.LinkCount > 0)
                    {
                        <div class="alert alert-info px-2 py-1 mt-1 mb-0">
                            This link library has @Model.LinkCount links in it. If you wish to
                            delete it you must first
                            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Links)"
                               asp-area=""
                               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                               asp-route-linkLibrarySlug="@Model.LinkLibrarySlug"
                               asp-route-sectionSlug="@Model.SectionSlug">delete those links</a>.
                        </div>
                    }
                </div>
                <div class="card-footer d-flex justify-content-end">
                    @if (!Model.IsNew)
                    {
                        <button class="btn btn-outline-danger btn-sm me-2"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                            @(Model.LinkCount == 0 ? null : "disabled='disabled'")
                                type="button">
                            Delete Link Library
                        </button>
                    }
                    <button class="btn btn-outline-primary btn-sm"
                            type="submit">
                        Save
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.LinkCount == 0 && !Model.IsNew)
{
    <form asp-action="@nameof(SectionController.DeleteLinkLibrary)"
          asp-route-linkLibrarySlug="@Model.LinkLibrarySlug"
          asp-route-sectionSlug="@Model.SectionSlug"
          method="post">
        <div aria-hidden="true"
             aria-labelledby="deleteLabel"
             class="modal fade"
             data-bs-backdrop="static"
             data-bs-keyboard="false"
             id="deleteModal"
             tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="deleteLabel">Delete link library</h1>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button">
                        </button>
                    </div>
                    <div class="modal-body d-flex">
                        <div class="text-danger">
                            <span aria-hidden="true"
                                  class="fa-solid fa-triangle-exclamation fa-lg fa-fw me-3"></span>
                        </div>
                        <div class="d-flex-grow-1">
                            <p class="mb-0">
                                Are you sure you want to delete this post?
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                                type="button">
                            Close
                        </button>
                        <button class="btn btn-outline-danger" type="submit">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
