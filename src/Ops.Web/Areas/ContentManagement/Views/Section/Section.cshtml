@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Section.SectionViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Section Administration
            <small class="text-muted d-print-block">
                @Model.Section.Name
            </small>
        </h1>
        <div class="d-print-none">
            @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
            {
                <a asp-action="@nameof(SectionController.Permissions)"
                   asp-route-slug="@Model.Section.Slug"
                   class="btn btn-sm btn-outline-primary mt-1 ms-2">
                    Permissions
                </a>
                if (Model.CanBeDeleted)
                {
                    <button class="btn btn-sm btn-outline-danger mt-1 ms-2"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteSection">
                        Delete Section
                    </button>
                }
            }
            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.SectionIndex)"
               asp-area=""
               asp-controller="@HomeController.Name"
               asp-route-slug="@Model.Section.Slug"
               class="btn btn-sm btn-outline-primary mt-1 ms-2">
                View Section
            </a>
            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Index)"
               asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
               class="btn btn-sm btn-outline-dark mt-1 ms-2">Back</a>
        </div>
    </div>
}
<div class="row">
    <div class="col-9">
        @if (!string.IsNullOrEmpty(Model.Section.EmbedVideoUrl))
        {
            <iframe width="590"
                    height="332"
                    src="@Model.Section.EmbedVideoUrl"
                    frameborder="0"
                    allowfullscreen=""></iframe>
        }
    </div>
</div>
<div class="row">
    <div class="col-md-6 col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <span class="lead fw-bold">
                    Posts
                </span>
                <small class="text-muted d-print-block">
                    @if (Model.PostCount > 5)
                    {
                        @:(First 5 of @Model.PostCount)
                    }
                    else if (Model.PostCount > 1)
                    {
                        @:(all @Model.PostCount posts)
                    }
                    else if (Model.PostCount == 1)
                    {
                        @:(only post)
                    }
                </small>

            </div>
            <div class="card-body p-0">
                @if (Model.Posts?.Count > 0)
                {
                    <table class="table table-sm table-hover mb-0">
                        @foreach (var post in Model.Posts)
                        {
                            <tr>
                                <td class="d-flex px-3 py-2">
                                    <div class="flex-grow-1 align-self-center">
                                        @post.Title
                                    </div>
                                    <div>
                                        @if (post.ShowOnHomePage)
                                        {
                                            <span class="fa-solid fa-house fa-fw text-muted"
                                                  title="This post is shown on the Intranet home page."></span>
                                        }
                                        @if (post.IsPinned)
                                        {
                                            <span class="fa-solid fa-map-pin fa-fw"
                                                  title="This post is pinned to the top until @post.PinnedUntil."></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="alert alert-info mt-3 px-3 py-2">
                            Section has no posts.
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer @(Model.Posts?.Count > 0 ? "border-top-0" : null)">
                <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.AddPost)"
                   asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                   asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                   asp-route-sectionSlug="@Model.Section.Slug"
                   class="btn btn-outline-success btn-sm">
                    <span class="fa-solid fa-circle-plus fa-fw"></span>
                    Add post
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card mb-4">
            <div class="card-header lead fw-bold">
                File Libraries
            </div>
            <div class="card-body p-0">
                @if (Model.FileLibraries?.Count > 0)
                {
                    <table class="table table-sm table-hover mb-0">
                        @foreach (var fileLibrary in Model.FileLibraries)
                        {
                            <tr>
                                <td class="d-flex px-3 py-2">
                                    <div class="flex-grow-1 align-self-center">
                                        <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Files)"
                                           asp-area=""
                                           asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                           asp-route-fileLibrarySlug="@fileLibrary.Slug"
                                           asp-route-sectionSlug="@Model.Section.Slug">@fileLibrary.Name</a>
                                        @if (fileLibrary.TotalFilesInLibrary == 1)
                                        {
                                            <small class="text-muted d-print-block">
                                                (@fileLibrary.TotalFilesInLibrary file)
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted d-print-block">
                                                (@fileLibrary.TotalFilesInLibrary files)
                                            </small>
                                        }
                                    </div>
                                    @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
                                    {
                                        <div>
                                            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.FileLibrary)"
                                               asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                                               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                                               asp-route-fileLibrarySlug="@fileLibrary.Slug"
                                               asp-route-sectionSlug="@Model.Section.Slug"
                                               class="btn btn-outline-primary btn-sm">
                                                <span class="fa-solid fa-pen-to-square fa-fw"></span>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="alert alert-info mt-3 px-3 py-2">
                            Section has no file libraries.
                        </div>
                    </div>
                }
            </div>
            @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
            {
                <div class="card-footer @(Model.FileLibraries?.Count > 0 ? "border-top-0" : null)">
                    <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.FileLibrary)"
                       asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                       asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                       asp-route-sectionSlug="@Model.Section.Slug"
                       class="btn btn-outline-success btn-sm">
                        <span class="fa-solid fa-circle-plus fa-fw"></span>
                        Add File Library
                    </a>
                </div>
            }
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card mb-4">
            <div class="card-header lead fw-bold">
                Link Libraries
            </div>
            <div class="card-body p-0">
                @if (Model.LinkLibraries?.Count > 0)
                {
                    <table class="table table-sm table-hover mb-0">
                        @foreach (var linkLibrary in Model.LinkLibraries)
                        {
                            <tr>
                                <td class="d-flex px-3 py-2">
                                    <div class="flex-grow-1 align-self-center">
                                        <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Links)"
                                           asp-area=""
                                           asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
                                           asp-route-linkLibrarySlug="@linkLibrary.Slug"
                                           asp-route-sectionSlug="@Model.Section.Slug">@linkLibrary.Name</a>
                                        @if (linkLibrary.TotalLinksInLibrary == 1)
                                        {
                                            <small class="text-muted d-print-block">
                                                (@linkLibrary.TotalLinksInLibrary link)
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted d-print-block">
                                                (@linkLibrary.TotalLinksInLibrary links)
                                            </small>
                                        }

                                    </div>
                                    @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
                                    {
                                        <div>
                                            <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.LinkLibrary)"
                                               asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                                               asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                                               asp-route-linkLibrarySlug="@linkLibrary.Slug"
                                               asp-route-sectionSlug="@Model.Section.Slug"
                                               class="btn btn-outline-primary btn-sm">
                                                <span class="fa-solid fa-pen-to-square fa-fw"></span>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </table>
                }
                else
                {
                    <div class="d-flex justify-content-center">
                        <div class="alert alert-info mt-3 px-3 py-2">
                            Section has no link libraries.
                        </div>
                    </div>
                }
            </div>
            @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
            {
                <div class="card-footer @(Model.LinkLibraries?.Count > 0 ? "border-top-0" : null)">
                    <a asp-action="@nameof(Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.LinkLibrary)"
                       asp-area="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Area"
                       asp-controller="@Ocuda.Ops.Controllers.Areas.ContentManagement.SectionController.Name"
                       asp-route-sectionSlug="@Model.Section.Slug"
                       class="btn btn-outline-success btn-sm">
                        <span class="fa-solid fa-circle-plus fa-fw"></span>
                        Add Link Library
                    </a>
                </div>
            }
        </div>
    </div>
</div>


@if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true && Model.CanBeDeleted)
{
    <form asp-action="@nameof(SectionController.DeleteSection)"
          asp-route-sectionSlug="@Model.Section.Slug"
          method="post">
        <div aria-hidden="true"
             aria-labelledby="deleteModalLabel"
             class="modal fade"
             id="deleteSection"
             tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="deleteModalLabel">Delete section</h1>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete this section? There is no undo!
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                                type="button">
                            Close
                        </button>
                        <button type="submit" class="btn btn-outline-danger">Delete Section</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
