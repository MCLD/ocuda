@model Ocuda.Ops.Controllers.Areas.ContentManagement.ViewModels.Category.IndexViewModel

@section header {
    <div class="d-flex justify-content-between align-items-top mb-2">
        <h1>
            Categories
        </h1>
        <div class="pt-1 d-print-none">
            @if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
            {
                <button class="btn btn-sm btn-outline-success mt-1 ms-2"
                        data-bs-toggle="modal"
                        data-bs-target="#addCategory">
                    <span class="fa-solid fa-circle-plus" aria-hidden="true"></span>
                    Add Section
                </button>
            }
            <a asp-action="@nameof(Ocuda.Ops.Controllers.HomeController.Index)"
               asp-area=""
               asp-controller="@Ocuda.Ops.Controllers.HomeController.Name"
               class="btn btn-sm btn-outline-dark mt-1 ms-2">Back</a>
        </div>
    </div>
}

@if (Context.User?.HasClaim(ClaimType.SiteManager, ClaimType.SiteManager) == true)
{
    <form asp-action="@nameof(CategoryController.Add)"
          asp-area="@CategoryController.Area"
          asp-controller="@CategoryController.Name"
          method="post">
        <input asp-for="Page" type="hidden" value="@Model.Page" />
        <div aria-hidden="true"
             aria-labelledby="addCategoryLabel"
             class="modal fade"
             data-bs-backdrop="static"
             data-bs-keyboard="false"
             id="addCategory"
             tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5"
                            id="addCategoryLabel">
                            Add category
                        </h1>
                        <button aria-label="Close"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                type="button"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="CategoryName" class="form-label"></label>
                            <input asp-for="CategoryName"
                                   class="form-control"
                                   type="text">
                        </div>
                        <div class="mb-3">
                            <label asp-for="CategorySlug" class="form-label"></label>
                            <input asp-for="CategorySlug"
                                   class="form-control"
                                   data-oc-slugify-from="CategoryName"
                                   type="text">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary"
                                data-bs-dismiss="modal"
                                type="button">
                            Close
                        </button>
                        <button class="btn btn-outline-primary" type="submit">Add</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}
