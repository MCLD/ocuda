@using Ocuda.Promenade.Controllers
@model Ocuda.Promenade.Controllers.ViewModels.DigitalLibrary.LaunchViewModel

<div class="d-flex justify-content-center mt-3">
    <div class="card">
        <div class="card-body text-center px-5 py-4">
            <h1 class="h2">
                @Localizer[Promenade.EmediaOnlyInLibrary]
            </h1>
            <p class="h3 mt-2 mb-3">
                @Localizer[Promenade.EmediaMustBeInLibrary, Model.Name]
            </p>
            <p class="h3">
                @Localizer[Promenade.LocationNearestLink,
                    Url.Action(nameof(LocationsController.Find),
                        LocationsController.Name,
                        new { area = string.Empty })]
            </p>
        </div>
    </div>
</div>
